{
  "name": "grossheide-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "serve out",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mts",
    "audit": "node scripts/audit.mjs",
    "check": "npm run check:contrast && npm run typecheck && npm run lint && npm run build",
    "check:mobile": "node scripts/mobile-check.mjs",
    "check:theme": "node scripts/theme-check.mjs",
    "check:chat": "node scripts/chat-check.mjs",
    "check:lighthouse": "node scripts/lighthouse-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "playwright": "1.56.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
